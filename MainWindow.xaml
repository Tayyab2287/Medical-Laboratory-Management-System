<Window x:Class="LabReportApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Report Management System" Height="900" Width="1120"
        MinHeight="760" MinWidth="960"
        Icon="Assets/Logo.ico"
        Background="{DynamicResource ColorBackground}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <!-- ScrollViewer wraps the whole page: if the content is taller than the window,
         a vertical scrollbar (slider) appears automatically on the right side. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
        Background="{DynamicResource ColorBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header banner -->
                <RowDefinition Height="Auto"/> <!-- Patient Details card -->
                <RowDefinition Height="Auto"/> <!-- Tests card -->
                <RowDefinition Height="Auto"/> <!-- Actions card -->
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER BANNER ================= -->
            <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Lab Report Management System" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Step 1: Bill the patient for requested tests. Step 2: Enter results later from 'Pending Reports' to send the report."
                                   FontSize="12" Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnToggleTheme" Grid.Column="1" Content="🌙 Dark Mode" Style="{StaticResource ThemeToggleButton}"
                            VerticalAlignment="Center" Click="btnToggleTheme_Click"/>
                </Grid>
            </Border>

            <!-- ================= PATIENT DETAILS ================= -->
            <Grid Grid.Row="1" Margin="20,20,20,0">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <StackPanel>
                        <TextBlock Text="Patient Details" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                <TextBlock Text="PATIENT NAME *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtName" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                                <TextBlock Text="PHONE NUMBER *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPhone" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                                <TextBlock Text="AGE *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAge" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                                <TextBlock Text="GENDER *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbGender" Height="32">
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                                <TextBlock Text="REFERRED BY" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtReferredBy" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                                <TextBlock Text="LAB NAME (leave blank for default)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtLabName" Height="32"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= SELECT TESTS (Stage 1 - Billing) ================= -->
            <Grid Grid.Row="2" Margin="20,16,20,0">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text="Select Tests for Bill" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                                <Button x:Name="btnManageTests" Content="Manage Tests" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" Click="btnManageTests_Click"/>
                            </DockPanel>
                            <TextBlock Text="Tip: type a Test Name below to see suggestions from your saved test list. Selecting one auto-fills Category, Unit, Normal Range and Price. Use 'Discount %' on a row for a per-test discount, or 'Overall Discount %' below for a discount on the whole bill (e.g. a doctor's reference discount). Results are entered later, after testing is done."
                                       FontSize="10.5" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- ============================================================
                             GRID SIZE: this DataGrid's Height controls how tall the tests
                             table is. Change the number below (in pixels) to make it bigger
                             or smaller - see the note at the end of this file for details. -->
                        <DataGrid Grid.Row="1" x:Name="dgResults" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Height="210" Margin="0,0,0,10">
                            <DataGrid.Columns>

                                <!-- CATEGORY (main heading) column with suggestions -->
                                <DataGridTemplateColumn Header="Category (Main Heading)" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CategoryHeading}" Padding="4,2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Text="{Binding CategoryHeading, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding AllCategories, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- TEST NAME column with live filtered autocomplete -->
                                <DataGridTemplateColumn Header="Test Name" Width="2.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TestName}" Padding="4,2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox x:Name="cmbTestName"
                                                      Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                      Loaded="TestNameCombo_Loaded"
                                                      KeyUp="TestNameCombo_KeyUp"
                                                      SelectionChanged="TestNameCombo_SelectionChanged"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1.2*"/>
                                <DataGridTextColumn Header="Normal Range" Binding="{Binding NormalRange}" Width="1.6*"/>
                                <DataGridTextColumn Header="Price (PKR)" Binding="{Binding Price}" Width="1.1*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Discount %" Binding="{Binding Discount}" Width="0.9*"/>
                                <DataGridTextColumn Header="Net Price (PKR)" Binding="{Binding NetPrice}" Width="1.2*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnAddRow" Content="+ Add Row" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0" Click="btnAddRow_Click"/>
                                <Button x:Name="btnRemoveRow" Content="Remove Selected Row" Style="{StaticResource SecondaryButton}"
                                        Click="btnRemoveRow_Click"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Subtotal:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,4,0"/>
                                <TextBlock x:Name="txtSubtotalAmount" Text="Rs. 0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,20,0"/>

                                <TextBlock Text="Overall Discount %:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtOverallDiscount" Width="55" Height="32" Text="0" VerticalContentAlignment="Center"
                                         TextChanged="txtOverallDiscount_TextChanged" Margin="0,0,20,0"/>

                                <TextBlock x:Name="txtDiscountAmount" Text="Discount: -Rs. 0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorDanger}" Margin="0,0,20,0"/>

                                <TextBlock x:Name="txtTotalAmount" Text="Total Payable: Rs. 0" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource ColorPrimaryDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= ACTIONS ================= -->
            <Grid Grid.Row="3" Margin="20,16,20,20">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnGenerateBill" Content="Generate Bill" Style="{StaticResource AccentButton}"
                                    FontSize="13" Click="btnGenerateBill_Click"/>
                            <Button x:Name="btnEnterResults" Content="Pending Reports (Enter Results)" Style="{StaticResource AccentButton}"
                                    Margin="10,0,0,0" Click="btnEnterResults_Click"/>
                            <Button x:Name="btnHistory" Content="View Past Reports" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="btnHistory_Click"/>
                            <Button x:Name="btnClear" Content="Clear Form" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="btnClear_Click"/>
                            <Button x:Name="btnBackupNow" Content="Backup Now" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="btnBackupNow_Click"/>
                            <Button x:Name="btnRestoreBackup" Content="Restore from Backup..." Style="{StaticResource DangerButton}"
                                    Margin="10,0,0,0" Click="btnRestoreBackup_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="txtStatus" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>