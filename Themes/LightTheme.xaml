<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== LIGHT THEME COLOR PALETTE ===================== -->
    <SolidColorBrush x:Key="ColorPrimary" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="ColorPrimaryDark" Color="#4472CC"/>
    <SolidColorBrush x:Key="ColorPrimaryLight" Color="#EAF1FE"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#22C1A3"/>
    <SolidColorBrush x:Key="ColorAccentDark" Color="#1AA48A"/>
    <SolidColorBrush x:Key="ColorDanger" Color="#EF6C7E"/>
    <SolidColorBrush x:Key="ColorDangerDark" Color="#D85268"/>
    <SolidColorBrush x:Key="ColorBackground" Color="#F5F8FC"/>
    <SolidColorBrush x:Key="ColorCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorBorder" Color="#DCE3EE"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#1F2937"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#8492A6"/>
    <SolidColorBrush x:Key="ColorHeaderBg" Color="#EEF3FC"/>
    <SolidColorBrush x:Key="ColorHeaderSubtitle" Color="#DCE8FF"/>
    <SolidColorBrush x:Key="ColorBannerBg" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="ColorScrollThumb" Color="#C9D2E0"/>

    <!-- Secondary/utility colors (previously hardcoded hex values in styles) -->
    <SolidColorBrush x:Key="ColorSecondaryBg" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="ColorSecondaryHoverBg" Color="#E1E6EF"/>
    <SolidColorBrush x:Key="ColorButtonDisabledBg" Color="#C9D4E3"/>
    <SolidColorBrush x:Key="ColorAccentDisabledBg" Color="#C9E7E0"/>
    <SolidColorBrush x:Key="ColorInputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorInputDisabledBg" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="ColorRowAlternate" Color="#F7FAFD"/>

</ResourceDictionary>