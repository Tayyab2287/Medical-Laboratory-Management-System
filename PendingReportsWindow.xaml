<Window x:Class="LabReportApp.PendingReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pending Reports" Height="540" Width="850"
        MinHeight="420" MinWidth="650" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER BANNER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Pending Reports" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Patients who have been billed but whose test results are not entered yet"
                           FontSize="11.5" Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Padding="10">
                    <DataGrid x:Name="dgPending" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Serial No" Binding="{Binding SerialNumber}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Age/Gender" Width="90">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="Age"/>
                                        <Binding Path="Gender"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="Billed On" Binding="{Binding CreatedAt}" Width="140"/>
                            <DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercentage}" Width="80"/>
                            <DataGridTextColumn Header="Payable (PKR)" Binding="{Binding NetAmount}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="btnEnterResults" Content="Enter Results for Selected Patient" Style="{StaticResource AccentButton}"
                        Click="btnEnterResults_Click"/>
                <Button x:Name="btnRefresh" Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" Click="btnRefresh_Click"/>
                <Button x:Name="btnClose" Content="Close" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" Click="btnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>