<Window x:Class="LabReportApp.TestDefinitionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Predefined Tests" Height="680" Width="800"
        MinHeight="520" MinWidth="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER BANNER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Manage Predefined Tests" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Category, Test Name, Unit, Normal Range and Price - used for autocomplete and billing"
                           FontSize="11.5" Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= ADD / EDIT FORM ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <StackPanel>
                        <TextBlock Text="Add / Edit Test" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                <TextBlock Text="CATEGORY (MAIN HEADING) *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCategory" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                                <TextBlock Text="TEST NAME *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTestName" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                                <TextBlock Text="UNIT" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtUnit" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                                <TextBlock Text="NORMAL RANGE" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNormalRange" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                                <TextBlock Text="PRICE (PKR) *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPrice" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="5,12,0,0">
                            <Button x:Name="btnSaveDefinition" Content="Save / Update Test" Style="{StaticResource AccentButton}"
                                    Click="btnSaveDefinition_Click"/>
                            <Button x:Name="btnClearForm" Content="Clear Form" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="btnClearForm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= LIST OF TESTS ================= -->
            <Grid Grid.Row="1">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Padding="10">
                    <DataGrid x:Name="dgDefinitions" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                              SelectionChanged="dgDefinitions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryHeading}" Width="2*"/>
                            <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="2.5*"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1.3*"/>
                            <DataGridTextColumn Header="Normal Range" Binding="{Binding NormalRange}" Width="1.8*"/>
                            <DataGridTextColumn Header="Price (PKR)" Binding="{Binding Price}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Tip: click a row above to load it for editing." VerticalAlignment="Center"
                           FontSize="10.5" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,20,0"/>
                <Button x:Name="btnDeleteDefinition" Content="Delete Selected" Style="{StaticResource DangerButton}"
                        Click="btnDeleteDefinition_Click"/>
                <Button x:Name="btnCloseWindow" Content="Close" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" Click="btnCloseWindow_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>