<Window x:Class="LabReportApp.EnterResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Test Results" Height="700" Width="950"
        MinHeight="500" MinWidth="750" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER BANNER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Enter Test Results" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtPatientSummary" FontSize="12" Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <DataGrid x:Name="dgResults" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryHeading}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" IsReadOnly="True" Width="2.3*"/>
                            <DataGridTextColumn Header="Result *" Binding="{Binding Result}" Width="1.8*"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="1.3*"/>
                            <DataGridTextColumn Header="Normal Range" Binding="{Binding NormalRange}" IsReadOnly="True" Width="1.8*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="btnSaveResults" Content="Save &amp; Send Report to Patient" Style="{StaticResource AccentButton}"
                        Click="btnSaveResults_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" Click="btnCancel_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtStatus" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
        </Grid>
    </Grid>
</Window>